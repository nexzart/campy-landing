{
  "name": "campy-landing",
  "version": "1.0.0",
  "private": true,
  "description": "Marketing site for Campy (school management software by Nexzart). htmx + Tailwind + Alpine + Lucide, deployed on Cloudflare Workers.",
  "scripts": {
    "start": "npm run dev",
    "dev": "npm run build && wrangler dev",
    "build": "node scripts/build.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@fontsource/poppins": "^5.3.0",
    "alpinejs": "^3.14.8",
    "htmx.org": "^2.0.4",
    "lucide-static": "^0.469.0",
    "tailwindcss": "^3.4.17",
    "wrangler": "^4.149.0"
  }
}
