{
  "name": "campy-landing",
  "version": "1.0.0",
  "private": true,
  "description": "Marketing site for Campy (school management software by Nexzart). htmx + Tailwind + Alpine + Lucide, deployed on Cloudflare Workers.",
  "scripts": {
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test:integration": "node scripts/test-integration.mjs",
    "test:email": "node scripts/test-email.mjs",
    "start": "npm run dev",
    "dev": "npm run build -- --dev && wrangler dev",
    "build": "node scripts/build.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@iconify-json/logos": "^1.2.16",
    "alpinejs": "^3.14.8",
    "htmx.org": "^2.0.4",
    "lucide-static": "^0.469.0",
    "simple-icons": "^16.35.0",
    "tailwindcss": "^3.4.17",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "nodemailer": "^10.1.1"
  }
}
