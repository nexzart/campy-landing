{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campy-landing",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /features serves features.html; /features.html redirects to /features.
    "html_handling": "auto-trailing-slash",
    // Unknown paths get dist/404.html with a 404 status.
    "not_found_handling": "404-page",
    // The Worker only runs for the htmx form endpoints; everything else is static.
    "run_worker_first": ["/api/*"]
  },
  // Demo requests ("demo:*") and newsletter sign-ups ("subscriber:*") from the htmx forms.
  "kv_namespaces": [
    { "binding": "LEADS", "id": "e1e530336e1143d8bed1973647eb65f4" }
  ],
  "routes": [
    { "pattern": "campy.nexzart.com", "zone_name": "nexzart.com", "custom_domain": true }
  ],
  // Keep the *.workers.dev URL as a fallback; canonical tags point search engines at campy.nexzart.com.
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  }
}
