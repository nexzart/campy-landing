{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campy-landing",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["*/5 * * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /features serves features.html; /features.html redirects to /features.
    "html_handling": "auto-trailing-slash",
    // Unknown paths get dist/404.html with a 404 status.
    "not_found_handling": "404-page",
    // Public form and authenticated admin APIs run in the Worker.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "campy-leads", "database_id": "fcf1ea8d-0a0a-42db-9f4b-8ca1202250cf", "migrations_dir": "migrations" }
  ],
  "routes": [
    { "pattern": "campy.nexzart.com", "zone_name": "nexzart.com", "custom_domain": true },
    { "pattern": "cms.nexzart.com", "zone_name": "nexzart.com", "custom_domain": true }
  ],
  // Keep the *.workers.dev URL as a fallback; canonical tags point search engines at campy.nexzart.com.
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  }
}
